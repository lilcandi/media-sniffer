{
  "manifest_version": 3,
  "name": "Media Sniffer 媒体嗅探器",
  "version": "1.5.0",
  "description": "嗅探网页中的视频、音频、图片以及 m3u8/HLS、mpd/DASH 流媒体资源，支持一键复制与下载 v1.5.0（m3u8 合并下载迁至独立扩展页，Chrome/Edge 稳定不中断）。",
  "permissions": [
    "webRequest",
    "storage",
    "downloads",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "媒体嗅探器",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
